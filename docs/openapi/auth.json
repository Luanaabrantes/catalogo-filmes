    "/auth/validar": {
      "get": {
        "tags": [
          "Auth-service"
        ],
        "summary": "Consultar sessão",
        "description": "Retorna id, nome, email e role atual da conta. Requer Authorization: Bearer JWT e papel atual consultado no banco. Proxy público existente: GET /api/auth/me. Teste esse proxy em /apidocs, com cookie; ele não aceita Bearer do navegador.",
