                "examples": {
                  "0": {
                    "value": {
                      "mensagem": "Erro interno do servidor."
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
